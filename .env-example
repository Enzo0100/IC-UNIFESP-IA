# Configurações de LLM
# Escolha o provedor: "google", "deepseek" ou "openrouter"
LLM_PROVIDER=

# OpenRouter API Key (nova chave para usar Gemini via OpenRouter)
OPENROUTER_API_KEY=

# Modelo a usar (padrão: google/gemini-2.5-flash-001 via OpenRouter)
MODEL=google/gemini-2.5-flash-001

# Configurações do Google Gemini (mantido para referência)
GOOGLE_API_KEY=
